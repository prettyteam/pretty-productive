 "feed": [
  {
   "id": "nsalon-6",
   "account": "taffetasalonandspa",
   "at": "2026-11-15T17:30:00-05:00",
   "ok": false,
   "urls": [
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-6-1.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-6-2.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-6-3.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-6-4.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-6-5.jpg"
   ],
   "caption": "Saved 40 hair photos and still not sure? Same. That’s what the consult is for.\n\nBring every screenshot. We’ll look at your texture, your routine and how much time you really want to spend on your hair, then make the look work for you. Book a consult at the link in bio.",
   "tags": "#HairConsultation #HairInspo #HammontonSalon #SouthJerseyHair #TaffetaSalonAndSpa"
  },
  {
   "id": "nsalon-8",
   "account": "taffetasalonandspa",
   "at": "2026-11-18T12:30:00-05:00",
   "ok": false,
   "urls": [
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-8-1.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-8-2.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-8-3.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-8-4.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-8-5.jpg"
   ],
   "caption": "Curled your hair for the party and by 9 pm it was straight again? It’s not you, it’s the timing.\n\nA style done the day of, set properly, lasts much longer than one you sleep on. Blow Dry $50, Blow Dry Plus $65, Formal Style $105. Book your party hair at the link in bio.",
   "tags": "#PartyHair #HolidayHair #Blowout #HammontonSalon #TaffetaSalonAndSpa"
  },
  {
   "id": "nsalon-9",
   "account": "taffetasalonandspa",
   "at": "2026-11-22T17:30:00-05:00",
   "ok": false,
   "urls": [
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-9-1.jpg"
   ],
   "caption": "Curling iron every morning before the holidays? Your ends are keeping score.\n\nUse a heat protectant every single time, and keep your tools under the highest setting. If your hair already feels rough, a K18 ($45) or Olaplex ($50) treatment at your next visit helps. Book at the link in bio.",
   "tags": "#HeatProtectant #HairDamage #K18 #HammontonSalon #TaffetaSalonAndSpa"
  },
  {
   "id": "nsalon-11",
   "account": "taffetasalonandspa",
   "at": "2026-11-25T12:30:00-05:00",
   "ok": false,
   "urls": [
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-11-1.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-11-2.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-11-3.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-11-4.jpg",
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-11-5.jpg"
   ],
   "caption": "At-home box dye the night before your color appointment? Well, that’s perfect. 😅 (We’ll still fix it, promise.)\n\nCome in with dry hair, worn how you usually wear it, and bring photos of what you love and what you don’t. It makes your color better every time. Book at the link in bio.",
   "tags": "#HairColor #ColorAppointment #HairTips #HammontonSalon #TaffetaSalonAndSpa"
  },
  {
   "id": "nsalon-12",
   "account": "taffetasalonandspa",
   "at": "2026-11-26T12:30:00-05:00",
   "ok": false,
   "urls": [
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nsalon-12-1.jpg"
   ],
   "caption": "Happy Thanksgiving from all of us at Taffeta. We’re so grateful for you. 🤍\n\nQuick tip before December gets busy: book your next visit before you leave the chair, so you’re not hunting for a spot later. Ask about our Beauty Membership ($75 a month) at the desk, or book at the link in bio.",
   "tags": "#HappyThanksgiving #Grateful #HammontonNJ #SouthJerseySalon #TaffetaSalonAndSpa"
  },
  {
   "id": "nspa-6",
   "account": "spa.taffeta",
   "at": "2026-11-16T17:30:00-05:00",
   "ok": false,
   "urls": [
    "https://prettyteam.taffetadesign.com/s-2570127300d0a38f/feed/nspa-6-1.jpg"
   ],
   "caption": "Holiday party or family photos coming up, and your skin isn’t cooperating?\n\nBook a Lift & Remodel (90 min, $200) a week or two before. It’s our Biologique Recherche facial for skin that looks tired, and makeup goes on smoother after. Book at the link in bio.",
   "tags": "#HolidaySkin #FacialTreatment #BiologiqueRecherche #SouthJerseySpa #TaffetaSpa"
  },
  {
   "id": "nspa-8",
   "account": "spa.taffeta",
   "at": "2026-11-19T12:00:00-05:00",
